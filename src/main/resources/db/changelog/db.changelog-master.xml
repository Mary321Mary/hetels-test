<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="Zaitsava Maria">
        <createTable tableName="hotels">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="address" type="VARCHAR(500)"/>
            <column name="phone" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="Zaitsava Maria">
        <insert tableName="hotels">
            <column name="name" value="DoubleTree by Hilton Minsk"/>
            <column name="description" value="The DoubleTree by Hilton Hotel Minsk offers 193 luxurious rooms in the Belarusian capital and stunning views of Minsk city from the hotel's 20th floor."/>
            <column name="address" value="9 Pobediteley Avenue, Minsk, 220004, Belarus"/>
            <column name="phone" value="+375 17 309-80-00"/>
        </insert>
        <insert tableName="hotels">
            <column name="name" value="Marriott Minsk Hotel"/>
            <column name="description" value="The Minsk Marriott Hotel is located in the historic center of the Belarusian capital, offering elegant rooms and world-class amenities."/>
            <column name="address" value="20 Pobediteley Avenue, Minsk, 220004, Belarus"/>
            <column name="phone" value="+375 17 309-90-00"/>
        </insert>
        <insert tableName="hotels">
            <column name="name" value="Hotel Europe Minsk"/>
            <column name="description" value="Hotel Europe is a boutique hotel situated in the heart of Minsk, featuring modern design and comfortable accommodations."/>
            <column name="address" value="11 Internatsionalnaya Street, Minsk, 220030, Belarus"/>
            <column name="phone" value="+375 17 229-83-33"/>
        </insert>
    </changeSet>

    <changeSet id="3" author="Zaitsava Maria">
        <!-- Drop old plain address and phone columns -->
        <dropColumn tableName="hotels" columnName="address"/>
        <dropColumn tableName="hotels" columnName="phone"/>

        <!-- Add structured columns -->
        <addColumn tableName="hotels">
            <column name="brand" type="VARCHAR(255)"/>
            <column name="house_number" type="INT"/>
            <column name="street" type="VARCHAR(255)"/>
            <column name="city" type="VARCHAR(255)"/>
            <column name="country" type="VARCHAR(255)"/>
            <column name="post_code" type="VARCHAR(20)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="check_in" type="VARCHAR(10)"/>
            <column name="check_out" type="VARCHAR(10)"/>
            <!-- Re-add phone column (now part of Contacts embeddable) -->
            <column name="phone" type="VARCHAR(50)"/>
        </addColumn>

        <!-- Create amenities collection table -->
        <createTable tableName="hotel_amenities">
            <column name="hotel_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amenity" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="hotel_amenities" baseColumnNames="hotel_id"
                                 referencedTableName="hotels" referencedColumnNames="id"
                                 constraintName="fk_hotel_amenities_hotel"/>
    </changeSet>

